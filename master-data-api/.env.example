# ===========================
# Master Data API
# ===========================

MASTER_DATA_API_DB_DBNAME=master_data
MASTER_DATA_API_DB_HOSTNAME=localhost
MASTER_DATA_API_DB_PORT=5432
MASTER_DATA_API_DB_USERNAME=postgres
MASTER_DATA_API_DB_PASSWORD=password
# SQLAlchemy pool per process. Defaults are 5 / 10.
MASTER_DATA_API_DB_POOL_SIZE=5
MASTER_DATA_API_DB_POOL_MAX_OVERFLOW=10
MASTER_DATA_API_DB_POOL_PRE_PING=true
MASTER_DATA_API_DB_POOL_RECYCLE=1800

MASTER_DATA_API_OPENAPI_ROOT_PATH=/
MASTER_DATA_API_PORT=8040

# ===========================
# Authentication
# ===========================

# Keycloak client / staff-portal application mnemonic for MASTER_DATA_ADMIN
# permission resolution on CRUD endpoints.
MASTER_DATA_API_KEYCLOAK_CLIENT_ID=master-data
MASTER_DATA_API_AUTH_PROVIDER_API_URL=http://localhost:8020
MASTER_DATA_API_AUTH_REDIS_URL=redis://localhost:6379/0

# Double-submit CSRF on state-changing requests (POST/PUT/PATCH/DELETE).
# Set to false for local API testing without browser cookies / X-CSRF-Token.
MASTER_DATA_API_CSRF_ENABLED=true

# ===========================
# Catalogue (versioned reference data)
# ===========================

# permission (approve with referenceData:publish / geo:publish, maker != checker)
# or awe (approval request in AWE; published on its signed callback).
MASTER_DATA_API_CATALOGUE_APPROVAL_MODE=permission
# Seconds between checks for future-effective versions coming into effect (0 = off).
MASTER_DATA_API_CATALOGUE_EFFECTIVE_REFRESH_SECONDS=300
# Outbox relay + legacy read-cache check, per worker (0 = off). Only one worker in
# the deployment relays at a time. Legacy reads are stale for at most this long
# after a publish on another worker/pod (and never longer than CACHE_EXPIRE_SECONDS).
MASTER_DATA_API_CATALOGUE_OUTBOX_RELAY_SECONDS=30
MASTER_DATA_API_CATALOGUE_OUTBOX_BATCH_SIZE=200
MASTER_DATA_API_CATALOGUE_COUNTRY=
# awe mode
MASTER_DATA_API_AWE_BASE_URL=
MASTER_DATA_API_AWE_CALLBACK_URL=http://localhost:8040/catalogue/awe/callback
MASTER_DATA_API_AWE_CALLBACK_SECRET_ID=master-data
MASTER_DATA_API_AWE_CALLBACK_HMAC_SECRET=
# Audit Manager (CloudEvents) and WebSub hub; empty disables. Delivered from the
# change log (outbox) with retries, including DB- and loader-written events.
MASTER_DATA_API_AUDIT_MANAGER_URL=
MASTER_DATA_API_WEBSUB_HUB_URL=
# Boundary GeoJSON store (S3/MinIO); empty endpoint disables upload/streaming.
MASTER_DATA_API_BOUNDARY_S3_ENDPOINT=
MASTER_DATA_API_BOUNDARY_S3_BUCKET=openg2p-geo
MASTER_DATA_API_BOUNDARY_S3_ACCESS_KEY=
MASTER_DATA_API_BOUNDARY_S3_SECRET_KEY=
MASTER_DATA_API_BOUNDARY_PUBLIC_BASE_URL=
