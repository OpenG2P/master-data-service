# Master Data Database
GEN2_MASTER_DATA_API_DB_USERNAME=postgres
GEN2_MASTER_DATA_API_DB_PASSWORD=password
GEN2_MASTER_DATA_API_DB_HOSTNAME=localhost
GEN2_MASTER_DATA_API_DB_PORT=5432
GEN2_MASTER_DATA_API_DB_DBNAME=master_data

# Registry database (read-only: g2p_registry_data_policies for GEO data-policy resolution)
GEN2_MASTER_DATA_API_REGISTRY_DB_USERNAME=postgres
GEN2_MASTER_DATA_API_REGISTRY_DB_PASSWORD=password
GEN2_MASTER_DATA_API_REGISTRY_DB_HOSTNAME=localhost
GEN2_MASTER_DATA_API_REGISTRY_DB_PORT=5432
GEN2_MASTER_DATA_API_REGISTRY_DB_DBNAME=nsr

# IAM — master-data settings (GEN2_MASTER_DATA_API_ prefix)
GEN2_MASTER_DATA_API_KEYCLOAK_CLIENT_ID=registry-staff-portal

# IAM — iam-core middleware settings (COMMON_ prefix)
# JWKS / token validation endpoint (IAM staff portal API URL)
COMMON_AUTH_PROVIDER_API_URL=http://localhost:8000/api/v1/iam-staff

# Registry Redis URL — must match the Redis used by registry staff portal / IAM
# for OAuth refresh-token and session storage. Required when ValidateAndRefreshTokenMiddleware
# is enabled and browser requests include the X-Session-Id cookie.
COMMON_AUTH_REDIS_URL=redis://localhost:6379/0
